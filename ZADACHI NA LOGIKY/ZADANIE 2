a = int(input())          #вводим начало диапазона
b = int(input())          #вводим конец диапазона

chet = 0                  #считает количество четных чисел
nechet = 0                #считает количество нечетных чисел 
for i in range(a, b+1):   #перебираем все значения от a до b, (b +1, потому что если не прибавить единицу, то пайтон возьмет предыдущее число)
    if i % 2 == 0:        #проверяет числа на то будут делить они на два
        chet += 1         #прибавляет к счетчику четных чисел единицу, если число четное
    else:                 
        nechet += 1       #прибавляет к счетчику нечетных чисел единицу, если число оказывается нечетным

print(chet - nechet)      #вычитает из количества четных чисел количество нечетных
