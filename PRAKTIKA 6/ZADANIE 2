    print("Зеленый")
    
elif  1<= number <= 10:
    if number % 2 == 1:
        print("красный")
    else:
        print("черный")
        
elif 11<= number <= 18:
    if number % 2 == 1:
        print("черный")
    else:
        print("красный")

elif 19<= number <= 28:
    if number % 2 == 1:
        print("красный")
    else:
        print("черный")

elif 29<= number <= 36:
    if number % 2 == 1:
        print("черный")
