shopping_list = ["хлеб", "молоко", "сыр", "яблоки"]
shopping_list.append("шоколад")
print("Список покупок:", shopping_list)
unique_items = set(shopping_list)

print("Множество:", unique_items)
#С помощью set() из списка было создано множество unique_items. Множество отличается от списка тем, что хранит только уникальные элементы и не сохраняет порядок элементов
