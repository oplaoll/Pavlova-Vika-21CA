shopping_list = ["мыло", "брусника", "кола", "семечки"]
shopping_list.append("шоколад")
print("Список покупок:", shopping_list)
unique_items = set(shopping_list)

print("Множество:", unique_items)

#С помощью метода append() добавиляем новый продукт. Затем из списка создали множество с помощью функции set(). Список сохраняет порядок элементов и допускает повторения, а множество содержит только уникальные элементы
